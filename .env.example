# Web authentication: copy these two PUBLIC values to web/.env.local.
# Use the project's publishable key, never a service_role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Gateway server-only values: put real values in web/.env.local or deployment secrets.
# Never expose these through NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Ollama runs locally and does not require an API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Reserved for future Auto routing; not used by this task.
AI_DEFAULT_PROVIDER=

# Reserved for future FastAPI integrations; not used by the Web AI Gateway.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
