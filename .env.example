# Web authentication: copy these two PUBLIC values to web/.env.local.
# Use the project's public anon key, never a service_role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved examples for FUTURE backend integrations; leave blank for now.
# Copy relevant variables to server/.env only when the backend is implemented.
# Never expose private keys through NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
