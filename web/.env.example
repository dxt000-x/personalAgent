# Supabase public project settings required for authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Knowledge ingestion transitions only. Create the dedicated login role after
# reviewing the migration; use its project-specific TLS connection URL.
# Never use postgres, service_role, or an admin database URL here.
# Use Supabase shared Transaction Pooler (:6543) and its verified root CA.
KNOWLEDGE_DB_URL=
KNOWLEDGE_DB_CA_CERT_BASE64=

# Optional cloud AI providers. Keep private keys server-side.
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local Ollama provider. No cloud API key is needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
